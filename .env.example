# ==============================================================================
# ProductMind X — Environment Configuration Template
# Copy this file to '.env' and adjust values for your local environment.
# Never commit real API keys or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OmniRoute AI Gateway Configuration (Recommended)
# ------------------------------------------------------------------------------
# Default local OmniRoute instance (omniroute serve --no-open --port 20128)
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=sk-omniroute-productmind-key

# Provider-qualified pinned model identifier
PINNED_MODEL_ID=groq/openai/gpt-oss-120b

# Governance Policies (Strict zero-hallucination model pinning)
ALLOW_MODEL_SWITCHING=False
FALLBACK_ROUTING_ENABLED=False
ALLOW_AUTO_ROUTING=False

# ------------------------------------------------------------------------------
# 2. Upstream Provider Keys (Server-Side / OmniRoute Keyring)
# ------------------------------------------------------------------------------
# Groq (Free tier high-speed inference)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter (Optional multi-provider endpoint)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini (Optional free tier OpenAI-compatible endpoint)
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. Local Offline Fallback (Ollama)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# ------------------------------------------------------------------------------
# 4. NLP & Vector Retrieval Settings
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
SENTIMENT_MODEL=distilbert/distilbert-base-uncased-finetuned-sst-2-english
SAMPLE_REVIEWS_PER_CATEGORY=1500
RETRIEVER_TOP_K=6
